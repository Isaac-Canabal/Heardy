# Copia a .env y rellena. .env está en .gitignore: no lo comitees.

# Clave compartida que la app manda en la cabecera X-Api-Key.
# Genérala con:  make-key.bat   (o, en Linux/macOS: openssl rand -hex 32)
# Para un servidor PERSONAL, esto es lo único que hace falta rellenar.
HEARDY_API_KEY=

# Varias claves con nombre, para un servidor OFICIAL compartido por un grupo
# cerrado de personas — cada una con la suya, para poder revocar el acceso
# de una sola sin rotar la de las demás. Formato: "etiqueta:clave,etiqueta:clave".
# Si se define, se usa además de (no en vez de) HEARDY_API_KEY de arriba.
# HEARDY_API_KEYS=isaac:xxxxxxxx,ana:yyyyyyyy,carlos:zzzzzzzz

# Solo para pruebas locales en loopback: desactiva la autenticación.
# HEARDY_ALLOW_NO_AUTH=1

# Etiquetas (de las de arriba) con permiso de administrador: hoy sólo
# DELETE /cache y GET /health/detail (estado de cookies y de los límites).
# Vacío por defecto — nadie puede usar esas dos rutas hasta configurarlo.
# En un servidor personal (una sola clave, etiqueta "default"):
# HEARDY_ADMIN_LABELS=default
# En el oficial, sólo la etiqueta del operador — nunca la de un beta tester.
# HEARDY_ADMIN_LABELS=isaac

# /docs y /openapi.json (Swagger, esquema completo de la API) quedan
# apagados por defecto: sin autenticación, le dan a cualquiera el contrato
# exacto del servidor gratis. Encender sólo en desarrollo local.
# HEARDY_ENABLE_DOCS=1

# Límite de peticiones. 0 (por defecto) = desactivado, que es el
# comportamiento de siempre — pensado solo para el servidor oficial
# compartido. Ver docs/arquitectura_servidor_hibrido.md, sección 5.
# HEARDY_RATE_LIMIT_PER_KEY=20
# HEARDY_RATE_LIMIT_WINDOW_SECONDS=3600
# HEARDY_DAILY_QUOTA=150

# Tamaño máximo de la caché de audio en disco.
# HEARDY_CACHE_MAX_MB=2048

# Extracciones simultáneas. Subirlo gasta el presupuesto de IP más rápido
# sin dar throughput real; ver docs/investigacion_muro_antibot.md.
# HEARDY_MAX_CONCURRENT=2

# Cotas de seguridad.
# HEARDY_MAX_PLAYLIST_ENTRIES=500
# HEARDY_MAX_SEARCH_RESULTS=50

# Dónde escucha la API. 127.0.0.1 solo permite conexiones desde esta máquina.
# Para probar desde el móvil por la LAN hay que poner 0.0.0.0 a conciencia
# (con Tailscale no hace falta: la IP 100.x ya es de esta máquina).
# HEARDY_HOST=127.0.0.1
# HEARDY_PORT=8080

# URL del proveedor de PO tokens. El valor por defecto es el de run-pot.bat.
# docker-compose lo cambia solo al nombre del servicio.
# HEARDY_POT_PROVIDER_URL=http://127.0.0.1:4416

# Dónde guardar la caché de audio. Por defecto server/.cache
# HEARDY_CACHE_DIR=

# Cookies en formato Netscape. Suben la tasa de éxito en vídeos con
# restricción de edad, pero atan las descargas a una cuenta real de YouTube.
# Móntalo como volumen si lo usas.
# HEARDY_COOKIES_FILE=/data/cookies.txt

